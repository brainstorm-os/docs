---
import Default from "@astrojs/starlight/components/Head.astro";

// Starlight's <Head> emits og:title/description/url/type/locale/site_name and
// twitter:card, but no image — which leaves every Open Graph card incomplete
// (and a `summary_large_image` twitter:card with nothing to show). The share
// image is the same one the marketing site uses, so a docs link and a site link
// unfurl identically.
const ogImage = new URL("/og.png", Astro.site ?? "https://docs.getbrainstorm.online").toString();
---

<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta
	property="og:image:alt"
	content="Brainstorm — a desktop OS for you and your AI"
/>
<meta name="twitter:image" content={ogImage} />

<script is:inline>
	// Adopt the theme shared across getbrainstorm.online subdomains (set by the
	// marketing site) before Starlight paints, so the docs open in the same theme.
	(() => {
		const m = document.cookie.match(/(?:^|; )bs-theme=(light|dark)/);
		if (!m) return;
		try {
			localStorage.setItem("starlight-theme", m[1]);
		} catch (_) {}
		document.documentElement.dataset.theme = m[1];
	})();
</script>

<Default><slot /></Default>

<script>
	import { init } from "@amplitude/analytics-browser";

	if (!window.__amplitudeInitialized) {
		window.__amplitudeInitialized = true;
		// Cookieless on purpose (same config as the marketing site): no AMP_*
		// cookies, no persistent identifier, no IP capture — nothing to consent to.
		init("cca1e2687dc8b1388f4b33372a97fdaa", {
			serverZone: "EU",
			identityStorage: "none",
			trackingOptions: { ipAddress: false },
			autocapture: {
				attribution: false,
				pageViews: true,
				sessions: true,
				formInteractions: true,
				fileDownloads: true,
				elementInteractions: true,
			},
		});
	}
</script>

<script is:inline>
	// Mirror the docs theme back to the shared cookie so the site matches too.
	(() => {
		const root = document.documentElement;
		const write = () => {
			const t = root.dataset.theme;
			if (t !== "light" && t !== "dark") return;
			const dom = location.hostname.endsWith("getbrainstorm.online")
				? "; domain=.getbrainstorm.online"
				: "";
			document.cookie = `bs-theme=${t}; path=/; max-age=31536000; samesite=lax${dom}`;
		};
		write();
		new MutationObserver(write).observe(root, {
			attributes: true,
			attributeFilter: ["data-theme"],
		});
	})();
</script>
